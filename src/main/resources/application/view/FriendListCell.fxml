<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane fx:id="friendCell" prefHeight="111.0" prefWidth="632.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.FriendListCellController">
   <children>
      <Label fx:id="friendUserName" layoutX="167.0" layoutY="39.0" text="Label" />
      <StackPane fx:id="friendAvatarContainer" layoutX="24.0" layoutY="16.0" prefHeight="81.0" prefWidth="81.0">
         <children>
            <ImageView fx:id="friendAvatar" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>
      <StackPane fx:id="callIconContainer" layoutX="473.0" layoutY="20.0" prefHeight="71.0" prefWidth="71.0">
         <children>
            <ImageView fx:id="callIcon" fitHeight="70.0" fitWidth="70.0" onMouseClicked="#letCall" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../img/call.png" />
               </image>
            </ImageView>
         </children>
      </StackPane>
      <Label layoutX="557.0" layoutY="15.0" prefHeight="81.0" prefWidth="53.0" />
   </children>
</AnchorPane>
